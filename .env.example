# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=dsk_stockers_development

# Rails から見たデータベース。ホスト名 db は Compose のサービス名。
DATABASE_HOST=db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=dsk_stockers_development

# 開発用メール（Mailpit）
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
